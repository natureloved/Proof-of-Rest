# Deployed contract addresses on Monad Testnet (chain ID 10143)
NEXT_PUBLIC_PROOF_OF_REST_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_REST_BADGE_ADDRESS=0x0000000000000000000000000000000000000000

# WalletConnect Cloud project id — get one free at https://cloud.reown.com
# (formerly cloud.walletconnect.com). REQUIRED for the WalletConnect QR / mobile
# option. If left as the placeholder below (or unset), the app automatically
# falls back to injected/browser-extension wallets only (MetaMask, Coinbase,
# etc.) and skips WalletConnect entirely — no crash, just fewer wallet options.
NEXT_PUBLIC_WALLETCONNECT_ID=proof-of-rest-demo

# --- RestGuardian agent (AI, OPTIONAL) ---
# The agent works WITHOUT any of these: with no key it uses a deterministic
# keyword/regex parser that always runs in the browser. Set a key ONLY if you
# want free-form natural-language phrasing handled by an LLM. On any failure
# (missing key, network error, bad response) it silently falls back to the
# deterministic parser, so the demo never breaks.
# NEXT_PUBLIC_OPENAI_API_KEY=
# NEXT_PUBLIC_LLM_MODEL=gpt-4o-mini
# NEXT_PUBLIC_LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
